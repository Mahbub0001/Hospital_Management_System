{
  "buildCommand": "pip install -r requirements-vercel.txt && python manage.py collectstatic --noinput",
  "outputDirectory": "staticfiles",
  "installCommand": "pip install -r requirements-vercel.txt",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "hospital.settings"
  }
}